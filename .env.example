DJANGO_SECRET_KEY=change-this-before-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
CORS_ALLOWED_ORIGINS=

# Optional: email yourself when someone uses the contact form (Gmail is free for personal use).
# PythonAnywhere free tier: prefer smtp.gmail.com (see DEPLOY_PYTHONANYWHERE.md).
# Use a Google "App password" if 2-step verification is on—never commit real secrets.
#
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=alpieguevarra.dev@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=alpieguevarra.dev@gmail.com
# CONTACT_NOTIFICATION_TO=alpieguevarra.dev@gmail.com
